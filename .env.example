# IP or DNS name visible to clients and used in the Caddy site address.
SITE_ADDRESS=local-ip-adress

# SQLite database path inside the backend container.
DB_NAME=/data/inventory.db

# Must be exactly 16, 24, or 32 bytes for AES.
AES_KEY=aes-key

LDAP_SERVER=ldap://dc.domain.internal
DOMAIN=domain
SERVICE_USER=ldap-service-user
SERVICE_PASSWORD=ldap-service-password
LDAP_SEARCH_BASE=DC=domain,DC=internal
GROUP_DN=CN=CN_EXAMPLE,OU=OU_EXAMPLE,DC=domain,DC=internal

SYSMASTER_USERNAME=sysmaster
SYSMASTER_PASSWORD=strong-local-password

SMTP_SERVER=mailserv.domain.example
SMTP_PORT=465
EMAIL_ADDRESS=sender-address
EMAIL_PASSWORD=sender-password